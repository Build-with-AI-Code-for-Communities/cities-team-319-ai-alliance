# --- App ---
APP_NAME=CoralAI
ENV=development
DEBUG=true
API_V1_PREFIX=/api

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Local default: SQLite file. For production, point to a managed Postgres instead —
# e.g. Neon (https://neon.tech, free tier): create a project, copy its connection
# string, and paste it here (keep ?sslmode=require if Neon includes it).
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/coral_ai?sslmode=require
DATABASE_URL=sqlite:///./coral_ai.db

# --- Local disk storage settings (used when STORAGE_BACKEND=local) ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
IMAGE_MAX_DIMENSION=1600

# --- Object storage backend ---
# "local" (default) writes to backend/uploads and backend/reports — fine for local
# dev, but hosts like Render's free tier wipe local disk on every redeploy/restart.
# Set to "s3" + fill in the S3_* vars below to persist uploads/reports in an
# S3-compatible bucket instead. Works with AWS S3, MinIO, or Cloudflare R2 (free
# 10GB tier — create a bucket + API token at https://dash.cloudflare.com/?to=/:account/r2).
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
# e.g. https://<account_id>.r2.cloudflarestorage.com for Cloudflare R2 (blank for AWS S3)
S3_REGION=auto
# R2 uses "auto"; AWS uses e.g. "us-east-1"
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_UPLOAD_PREFIX=uploads
S3_REPORT_PREFIX=reports
S3_PRESIGNED_URL_EXPIRY_SECONDS=3600

# --- Gemini Vision (Tier 1 — REQUIRED) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- NASA SST (Tier 2 — optional, graceful fallback if unset) ---
NASA_API_KEY=
NASA_SST_ENABLED=false

# --- Coral Risk Engine thresholds (°C) ---
RISK_TEMP_WARNING_C=29.5
RISK_TEMP_CRITICAL_C=30.5
